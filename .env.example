# PostgreSQL connection strings used by Prisma.
#
# Supabase (Project → Connect → ORMs → Prisma):
#   DATABASE_URL — transaction pooler (port 6543), used by the app at runtime.
#   DIRECT_URL   — session pooler / direct connection (port 5432), used by migrations and the seed.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# Local Postgres from docker-compose.yml (host port 5433). DIRECT_URL is optional here.
DATABASE_URL="postgresql://atlas:atlas@localhost:5433/mineral_atlas?schema=public"
